{
    "name": "takya-app",
    "version": "1.0.0",
    "private": true,
    "main": "index.ts",
    "engines": {
        "node": ">=22.13.0"
    },
    "scripts": {
        "start": "expo start",
        "android": "expo start --android",
        "ios": "expo start --ios",
        "typecheck": "tsc --noEmit",
        "test": "jest",
        "test:e2e": "maestro test __tests__/e2e",
        "ci": "npm run typecheck && npm run format:check && npm run lint && npm test -- --ci --watchAll=false",
        "verify": "npm run typecheck && npm run format && npm run lint",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "expo lint",
        "lint:fix": "expo lint --fix",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "prettier --write",
            "eslint --fix"
        ],
        "*.{json,md}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "eslint-config-expo": "~57.0.2",
        "expo": "~57.0.22",
        "expo-dev-client": "~57.0.19",
        "expo-file-system": "~57.0.7",
        "expo-font": "~57.0.4",
        "expo-splash-screen": "~57.0.9",
        "expo-sqlite": "~57.0.3",
        "expo-status-bar": "~57.0.1",
        "react": "19.2.3",
        "react-native": "0.86.3",
        "react-native-safe-area-context": "~5.7.0",
        "react-native-svg": "15.15.4"
    },
    "devDependencies": {
        "@testing-library/react-native": "^14.0.1",
        "@types/jest": "29.5.14",
        "@types/node": "^22.20.2",
        "@types/react": "~19.2.2",
        "babel-preset-expo": "~57.0.0",
        "esbuild": "^0.28.2",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "jest": "~29.7.0",
        "jest-expo": "~57.0.5",
        "lint-staged": "^17.5.1",
        "prettier": "^3.9.7",
        "react-dom": "^19.2.3",
        "react-native-web": "^0.21.2",
        "typescript": "~6.0.3"
    }
}
